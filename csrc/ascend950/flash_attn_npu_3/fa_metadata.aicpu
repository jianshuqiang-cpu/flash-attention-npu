#include "aicpu_api.h"
#include "fa_metadata_args.h"
#include "tilingdata.h"
#include "fwd_resource_plan.h"
#include "fwd_tiling_policy.h"
#include <cstdint>
#include <cstring>

namespace {
constexpr uint32_t Q_TILE_CEIL = 128;
constexpr uint32_t BASE_KV_SIZE = 128;

inline uint32_t CeilDiv(uint32_t a, uint32_t b)
{
    return (b == 0) ? 0 : (a + b - 1) / b;
}

inline uint32_t QNBlockTile(uint32_t qSeqlen, uint32_t groupSize,
                            bool restrictMergedRowsForLargeD)
{
    // Must match kernel GetQNBlockTile (S/N combined axis): several Q heads are
    // merged into one task. Using a per-head task count here overcounts
    // totalTaskNum for GQA/MQA and makes the kernel schedule phantom tasks past
    // the last batch, causing out-of-bounds GM access (507015).
    constexpr uint32_t Q_M_TILE_MAX = 128;
    constexpr uint32_t Q_N_SPLIT_ALIGN = 2;
    uint32_t tile = qSeqlen == 0U ? Q_M_TILE_MAX :
        (Q_M_TILE_MAX / qSeqlen) / Q_N_SPLIT_ALIGN * Q_N_SPLIT_ALIGN;
    if (restrictMergedRowsForLargeD && qSeqlen != 0U) {
        constexpr uint32_t MAX_M_FOR_LARGE_D = Q_M_TILE_MAX / 2U;
        uint32_t maxTile = MAX_M_FOR_LARGE_D / qSeqlen;
        maxTile = maxTile > 0U ? maxTile : 1U;
        tile = tile < maxTile ? tile : maxTile;
    }
    tile = tile < groupSize ? tile : groupSize;
    if (tile > Q_N_SPLIT_ALIGN) {
        tile = tile / Q_N_SPLIT_ALIGN * Q_N_SPLIT_ALIGN;
    }
    return tile < 1U ? 1U : tile;
}
}  // namespace

__global__ __aicpu__ uint32_t ComputeFAMetadata(void *args)
{
    FAMetadataArgs *metaArgs = reinterpret_cast<FAMetadataArgs *>(args);
    const bool hasMask = metaArgs->maskType != 0;
    FAInferTilingData *tilingData = reinterpret_cast<FAInferTilingData *>(
        metaArgs->metaOutAddr + fa_metadata::TilingOffset(hasMask));
    // metaOutAddr points to raw device memory, so C++ member initializers are
    // not executed. Clear the complete structure to keep newly added fields
    // (including Flash Decoding flags and schedules) disabled by default.
    std::memset(tilingData, 0, sizeof(FAInferTilingData));
    const int32_t *seqlensQ = reinterpret_cast<const int32_t *>(metaArgs->seqlensQAddr);
    const int32_t *cacheSeqlens = reinterpret_cast<const int32_t *>(metaArgs->cacheSeqlensAddr);
    const auto readLength = [](const int32_t *lengths, uint32_t batch, bool cumulative) {
        const uint32_t value = static_cast<uint32_t>(lengths[batch]);
        return cumulative ? static_cast<uint32_t>(lengths[batch + 1]) - value : value;
    };

    tilingData->batch = metaArgs->batch;
    tilingData->numHeads = metaArgs->numHeads;
    tilingData->kvHeads = metaArgs->numHeadsK;
    tilingData->embeddingSize = metaArgs->embeddingSize;
    tilingData->embeddingSizeV = metaArgs->embeddingSizeV;
    tilingData->blockSize = metaArgs->pagedKV != 0 ? metaArgs->blockSize : BASE_KV_SIZE;
    tilingData->maskType = metaArgs->maskType;
    tilingData->sparseMode = 0;
    tilingData->preToken = 0;
    tilingData->nextToken = 0;
    tilingData->globalWindowSize = 4;
    tilingData->localWindowSize = 0;
    tilingData->windowSizeLeft = metaArgs->windowSizeLeft;
    tilingData->windowSizeRight = metaArgs->windowSizeRight;

    PrefillLaunchInfo *launchInfo = nullptr;
    if (metaArgs->packedQueryRows != 0) {
        launchInfo = reinterpret_cast<PrefillLaunchInfo *>(metaArgs->metaOutAddr +
            fa_metadata::MetadataBytesWithKv(hasMask, metaArgs->batch));
        *launchInfo = {};
        if (seqlensQ[0] < 0 || seqlensQ[metaArgs->batch] < 0 ||
            static_cast<uint64_t>(seqlensQ[metaArgs->batch]) > metaArgs->packedQueryRows) {
            launchInfo->status = PrefillLengthStatus::OutsideStorage;
            AscendC::DataStoreBarrier();
            return 0;
        }
    }

    // Match host tiling's actual maximum, including callers whose declared
    // max_seqlen_q is a loose bound. The task grouping and UB policy must agree.
    uint32_t actualMaxQ = metaArgs->maxQSeqlen;
    uint64_t fullQ128Tasks = 0;
    bool fullQueryTileInEachBatch = true;
    if (seqlensQ != nullptr)
        actualMaxQ = 0;
    for (uint32_t b = 0; b < metaArgs->batch; ++b) {
        if (launchInfo != nullptr) {
            // Check signed lengths before the general scheduler converts to unsigned.
            if (seqlensQ[b + 1] < seqlensQ[b] || cacheSeqlens[b] < 0) {
                launchInfo->status = PrefillLengthStatus::NegativeLength;
                AscendC::DataStoreBarrier();
                return 0;
            }
            if (static_cast<uint64_t>(cacheSeqlens[b]) > metaArgs->pageCapacity) {
                launchInfo->status = PrefillLengthStatus::OutsideStorage;
                AscendC::DataStoreBarrier();
                return 0;
            }
        }
        const uint32_t len = seqlensQ ? readLength(seqlensQ, b, metaArgs->qCumulative) : metaArgs->maxQSeqlen;
        actualMaxQ = len > actualMaxQ ? len : actualMaxQ;
        fullQueryTileInEachBatch = fullQueryTileInEachBatch && len >= Q_TILE_CEIL;
        const uint32_t activeQ = fa950_plan::ActiveQueryRows(len, readLength(cacheSeqlens, b, metaArgs->kvCumulative), metaArgs->maskType != 0U,
                                                           metaArgs->windowSizeRight);
        fullQ128Tasks += uint64_t(activeQ / Q_TILE_CEIL) * metaArgs->numHeads;
    }
    uint32_t qBaseTile = fa950_plan::SelectQueryTile(metaArgs->embeddingSize, metaArgs->embeddingSizeV,
        actualMaxQ, fullQ128Tasks, metaArgs->blockDim, metaArgs->maskType == 4U,
        metaArgs->windowSizeLeft, metaArgs->windowSizeRight);
    const uint32_t embeddingSizeAligned16 =
        (metaArgs->embeddingSize + 15U) / 16U * 16U;
    const uint32_t embeddingSizeVAligned16 =
        (metaArgs->embeddingSizeV + 15U) / 16U * 16U;

    // Mixed BF16/FP8 KV: mirror the host tiling's paired-prefill and small-MTP
    // tile policy, otherwise the metadata path loses the paired pipeline.
    const uint32_t groupSizeTiles = metaArgs->numHeads / metaArgs->numHeadsK;
    const bool hasPairedWave = metaArgs->quantMode == 2U && fullQueryTileInEachBatch &&
                               (groupSizeTiles % 2U == 0U) && fullQ128Tasks >= 2ULL * metaArgs->blockDim;
    const bool pairedWindow =
        metaArgs->maskType == 4U && metaArgs->windowSizeLeft >= 511 && metaArgs->windowSizeRight == 0;
    const bool pairedFull = metaArgs->maskType != 4U && metaArgs->pagedKV != 0U &&
                            metaArgs->softcapActive == 0U && metaArgs->embeddingSize == 192U &&
                            metaArgs->embeddingSizeV == 192U;
    // The automatic path replaces the host tiler, whose policy uses the actual maximum.
    const uint32_t policyMaxQ = launchInfo != nullptr ? actualMaxQ : metaArgs->maxQSeqlen;
    if (hasPairedWave && fullQ128Tasks < 4ULL * metaArgs->blockDim && (pairedWindow || pairedFull)) {
        qBaseTile = fa950_plan::QueryTile(metaArgs->embeddingSize, metaArgs->embeddingSizeV, policyMaxQ);
    }
    if (metaArgs->quantMode == 2U && policyMaxQ >= 5U && policyMaxQ <= 8U &&
        groupSizeTiles == 16U &&
        !(metaArgs->maskType == 4U &&
          static_cast<uint64_t>(metaArgs->batch) * metaArgs->numHeadsK * 2U <= metaArgs->blockDim)) {
        qBaseTile = 128U;
    }

    tilingData->innerPrec = 0;
    tilingData->actSeqAval = 0;
    tilingData->qBaseTile = qBaseTile;
    tilingData->kvBaseTile = metaArgs->quantMode == 1 ? 256U : BASE_KV_SIZE;
    tilingData->quantMode = metaArgs->quantMode;
    tilingData->qkL1TileM = qBaseTile;
    tilingData->qkL1TileN = 256;
    tilingData->qkL1TileKLeft = embeddingSizeAligned16;
    tilingData->qkL1TileKRight = metaArgs->quantMode == 1 ? 128U : 192U;
    tilingData->pvL1TileM = qBaseTile;
    tilingData->pvL1TileN = embeddingSizeVAligned16;
    tilingData->pvL1TileKLeft = tilingData->kvBaseTile;
    tilingData->pvL1TileKRight = tilingData->kvBaseTile;
    tilingData->qL1BufNum = (hasPairedWave && qBaseTile == Q_TILE_CEIL) ? 2U : 1U;
    tilingData->kL1BufNum = 2;
    tilingData->vL1BufNum = 2;
    tilingData->pL1BufNum = 3;
    tilingData->qSeqlenAligned = 0;
    tilingData->kvSeqlenAligned = 0;

    uint32_t maxQSeqlen = 0;
    uint32_t maxKvSeqlen = 0;
    uint32_t totalTaskNum = 0;
    uint32_t firstBatchTaskNum = 0;
    const uint32_t groupSize = metaArgs->numHeads / metaArgs->numHeadsK;
    int32_t *kvCum = reinterpret_cast<int32_t *>(
        metaArgs->metaOutAddr + fa_metadata::KvSeqlenOffset(hasMask));
    kvCum[0] = 0;
    uint32_t kvCumSum = 0;
    for (uint32_t batchIdx = 0; batchIdx < metaArgs->batch; ++batchIdx) {
        uint32_t qSeqlen = metaArgs->maxQSeqlen;
        if (seqlensQ != nullptr) {
            qSeqlen = readLength(seqlensQ, batchIdx, metaArgs->qCumulative);
        }
        const uint32_t kvSeqlen = readLength(cacheSeqlens, batchIdx, metaArgs->kvCumulative);
        if (qSeqlen > maxQSeqlen) {
            maxQSeqlen = qSeqlen;
        }
        if (kvSeqlen > maxKvSeqlen) {
            maxKvSeqlen = kvSeqlen;
        }
        kvCumSum += kvSeqlen;
        kvCum[batchIdx + 1] = static_cast<int32_t>(kvCumSum);
        const uint32_t curQNBlockTile = QNBlockTile(
            qSeqlen, groupSize, qBaseTile < Q_TILE_CEIL);
        const uint32_t qNBlockNumPerGroup = CeilDiv(groupSize, curQNBlockTile);
        const uint32_t curQNBlockNum = qNBlockNumPerGroup * metaArgs->numHeadsK;
        const uint32_t curQSBlockNum = CeilDiv(qSeqlen, qBaseTile);
        const uint32_t curTaskNum = curQNBlockNum * curQSBlockNum;
        if (batchIdx == 0) {
            firstBatchTaskNum = curTaskNum;
        }
        totalTaskNum += curTaskNum;
    }
    tilingData->maxQSeqlen = maxQSeqlen;
    tilingData->maxKvSeqlen = maxKvSeqlen;
    tilingData->firstBatchTaskNum = firstBatchTaskNum;
    tilingData->totalTaskNum = totalTaskNum;

    const uint64_t blockDim = static_cast<uint64_t>(metaArgs->blockDim);
    tilingData->qkOutSize = fa_metadata::Mm1OutSize(blockDim);
    tilingData->smOnlineOutSize = fa_metadata::SmOnlineOutSize(blockDim);
    tilingData->pvOutSize = fa_metadata::Mm2OutSize(blockDim);
    tilingData->UpdateSize = fa_metadata::UpdateOutSize(blockDim);

    if (launchInfo != nullptr) {
        launchInfo->qBanks = tilingData->qL1BufNum;
        launchInfo->tasks = totalTaskNum;
    }
    AscendC::DataStoreBarrier();
    return 0;
}
