# Copyright (c) 2026, flash-attention-npu CI maintainers.
#
# 多 combo 专用镜像: 指定 CANN 基础镜像 + torch + torch_npu 版本。
# 由 ci/build_matrix_images.sh 读取 ci/build_matrix.tsv, 为每个 combo 构建一次:
#
#   docker build -t fla-npu-matrix:<name> \
#     --build-arg BASE_IMAGE=<cann image> \
#     --build-arg PY_TAG=cp312 \
#     --build-arg TORCH_VER=2.9.0 \
#     --build-arg TORCH_NPU_VER=2.9.0.post2 \
#     --build-arg TORCH_NPU_RELEASE=v26.0.0-pytorch2.9.0 \
#     -f ci/Dockerfile.matrix ci/
#
# 镜像内只装工具链 (CANN 来自基础镜像 + torch/torch_npu), 不含本仓源码;
# 源码在 ci/run_ci_matrix.sh 运行时挂载。

ARG BASE_IMAGE
ARG PY_TAG
ARG TORCH_VER
ARG TORCH_NPU_VER
ARG TORCH_NPU_RELEASE
FROM ${BASE_IMAGE}

# FROM 之前声明的 ARG 只能用于 FROM 本身; 构建阶段内使用需重新声明 (不带值,
# 会继承 FROM 之前传入的同名 ARG 值)。否则 RUN 指令里这些变量会是空字符串。
ARG PY_TAG
ARG TORCH_VER
ARG TORCH_NPU_VER
ARG TORCH_NPU_RELEASE
# ARCH 在 FROM 之前未声明 (FROM 不需要), 这里直接给默认值 x86_64;
# --build-arg ARCH=... 会覆盖默认值。取值: x86_64 / aarch64。
ARG ARCH=x86_64

# CANN toolkit home (官方镜像一般已设; 显式声明防缺失)。8.5.0/9.0.0 镜像若路径不同,
# 在此调整或改用基础镜像自带的 set_env.sh。
ENV ASCEND_TOOLKIT_HOME=/usr/local/Ascend/ascend-toolkit/latest
ENV ASCEND_HOME_PATH=${ASCEND_TOOLKIT_HOME}
ENV LD_LIBRARY_PATH=${ASCEND_TOOLKIT_HOME}/lib64:${ASCEND_TOOLKIT_HOME}/runtime/lib64:${LD_LIBRARY_PATH:-}
ENV PATH=${ASCEND_TOOLKIT_HOME}/bin:${ASCEND_TOOLKIT_HOME}/compiler/ccec_compiler/bin:${PATH:-}

# pip: 基础镜像配置的镜像源可能缺包 (实测 950 镜像装 setuptools 报 "from versions: none"),
# 加阿里云源作为额外索引兜底; pip 会合并所有索引的可用版本, 后续 pip 操作一并受益。
ENV PIP_EXTRA_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 1. 基础工具
RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
      apt-get update -qq && apt-get install -y -qq \
        git curl wget jq build-essential cmake ninja-build \
        && rm -rf /var/lib/apt/lists/*; \
    elif command -v yum >/dev/null 2>&1; then \
      yum install -y -q git curl wget jq gcc-c++ make cmake ninja-build \
        && yum clean all; \
    fi

# 2. Python 包管理工具
RUN python3 -m pip install --upgrade pip wheel setuptools

# 3. torch: x86_64 下载指定 cpu wheel 安装 (URL 含 %2B, URL 编码的 +);
#    aarch64 无官方 +cpu wheel, 走 pip 从 PyPI 安装 manylinux aarch64 wheel。
RUN cd /tmp && \
    if [ "${ARCH}" = "x86_64" ]; then \
      wget -q -O torch.whl \
        "https://download.pytorch.org/whl/cpu/torch-${TORCH_VER}%2Bcpu-${PY_TAG}-${PY_TAG}-manylinux_2_28_x86_64.whl" && \
      python3 -m pip install --no-cache-dir torch.whl && \
      rm -f torch.whl; \
    else \
      python3 -m pip install --no-cache-dir "torch==${TORCH_VER}"; \
    fi

# 4. torch_npu (按 PY_TAG + ARCH + gitcode release tag)
RUN cd /tmp && \
    wget -q -O torch_npu.whl \
      "https://gitcode.com/Ascend/pytorch/releases/download/${TORCH_NPU_RELEASE}/torch_npu-${TORCH_NPU_VER}-${PY_TAG}-${PY_TAG}-manylinux_2_28_${ARCH}.whl" && \
    python3 -m pip install --no-cache-dir torch_npu.whl && \
    rm -f torch_npu.whl

# 5. 编译/测试所需 Python 包 (本仓不依赖 triton)
RUN python3 -m pip install --no-cache-dir \
      pybind11 \
      einops \
      packaging \
      psutil \
      pytest \
      numpy

# 6. 校验 torch / torch_npu 可 import (不触卡, 仅模块可用性)
RUN python3 - <<'PY'
import torch, torch_npu
print("torch:", torch.__version__)
print("torch_npu:", torch_npu.__version__)
PY

WORKDIR /workspace/flash-attention-npu
