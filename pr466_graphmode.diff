-        // One availability token for every physical 64-KB L0C slot.
-        for (uint32_t eventId = 0; eventId < Catlass::Gemm::Ascend950FagL0CLayout::L0C_SLOT_NUM; ++eventId) {
-            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(eventId);
