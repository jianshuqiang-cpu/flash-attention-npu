-def specs_of(function):
-    seen = set()
-
-    def visit(fn):
-        fn = inspect.unwrap(getattr(fn, "fn", fn))
-        if not inspect.isfunction(fn) or id(fn) in seen:
-            return ()
-        seen.add(id(fn))
-        values = inspect.getclosurevars(fn).nonlocals
-        if "specs" in values:
-            return values["specs"]
-        for value in values.values():
-            result = visit(value)
-            if result:
-                return result
-        return ()
-
-    return visit(function)
