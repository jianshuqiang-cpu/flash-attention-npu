-    lines = [
-        "import catlass.tla as tla",
-        "",
-        "@tla.jit",
-        "def stage(cache, aux, scalars, qstart, vi, k0, k1, b, h, info):",
-        "    tid, _, _ = tla.arch.thread_idx()",
-        "    q = tla.Int32(0)",
-        "    k = tla.Int32(0)",
