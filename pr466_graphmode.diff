+    def expected_mask(b, h, q, k, info, aux, scalars):
+        if kind == "mini_causal":
+            return q % 128 >= k % 128
+        if kind == "block_diagonal":
+            return q // 128 == k // 128
+        if kind == "negative_floor":
+            return (q - k) // 128 == -1
