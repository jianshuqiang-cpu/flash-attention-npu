+def _counted_sparse_blocks(capacity=32):
+    counts = torch.arange(16, dtype=torch.int32).reshape(1, 1, 16).repeat(1, 4, 1)
+    counts[0, 1] = 20 - counts[0, 1]
+    counts[0, 2] = 0
+    counts[0, 3] = capacity
+    counts.clamp_(max=capacity)
+    pc, fc = counts // 3, counts - counts // 3
